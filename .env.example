# Database Configuration
DATABASE_URL="file:./prisma/dev.db"

# Local/public API base (optional; same-origin preferred)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# OpenRouter (server-side only — never use NEXT_PUBLIC_ prefix)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# App URL (used for OpenRouter HTTP-Referer)
NEXTAUTH_URL=http://localhost:3000
