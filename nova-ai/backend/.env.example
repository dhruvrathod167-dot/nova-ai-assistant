# Backend Settings
PROJECT_NAME="NOVA AI"
API_V1_STR="/api"
SECRET_KEY="super_secret_nova_ai_key_change_me_in_production"

# Database Connection
DATABASE_URL="sqlite+aiosqlite:///./nova_ai.db"

# AI Provider Configuration
AI_PROVIDER="ollama"

# Ollama settings (Local LLM)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# OpenAI-Compatible settings
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL="gpt-4o"

# RAG Configuration
UPLOAD_DIR="uploads"
