# Backend Settings
PROJECT_NAME="NOVA AI"
API_V1_STR="/api"
SECRET_KEY="your_production_secret_key_here_change_me"

# Database Connection
DATABASE_URL="sqlite+aiosqlite:///./nova_ai.db"
# For production, use PostgreSQL: DATABASE_URL="postgresql+asyncpg://user:password@host:port/database"

# AI Provider Configuration
AI_PROVIDER="openai"

# OpenAI-Compatible settings
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL="gpt-4o"

# OpenRouter settings (for free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"

# Gemini settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="gemini-3.5-flash-lite"

# Ollama settings (Local LLM)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# RAG Configuration
UPLOAD_DIR="uploads"

# Production Environment
ENVIRONMENT="production"
# Render-specific settings
RENDER_EXTERNAL_URL="https://nova-ai-client.onrender.com"
RENDER_EXTERNAL_HOSTNAME="nova-ai-client.onrender.com"