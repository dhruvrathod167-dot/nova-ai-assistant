# Backend Settings
PROJECT_NAME="NOVA AI"
API_V1_STR="/api"
SECRET_KEY="super_secret_nova_ai_key_change_me_in_production"

# Database Connection
# SQLite fallback is default. For PostgreSQL, use:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/nova_ai"
DATABASE_URL="sqlite+aiosqlite:///./nova_ai.db"

# AI Provider Configuration
# Choose either 'ollama' or 'openai'
AI_PROVIDER="ollama"

# Ollama settings (Local LLM)
# Use http://host.docker.internal:11434 if connecting from inside docker containers on Windows/macOS
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# OpenAI-Compatible settings
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# RAG & Directory config
UPLOAD_DIR="uploads"
